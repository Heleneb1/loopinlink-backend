# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais committer .env.

# --- Django ---
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-with-a-long-random-key
# True en local uniquement. Toujours False en production.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# CSRF_TRUSTED_ORIGINS=https://ton-domaine.fr

# --- Base de données ---
# Sans ces variables, SQLite est utilisé en local.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nom_de_db
# DB_USER=utilisateur_db
# DB_PASSWORD=mot_de_passe_db
# DB_HOST=localhost
# DB_PORT=5432

# --- Cookies (HTTPS non requis en local) ---
AUTH_COOKIE_DOMAIN=localhost
SESSION_COOKIE_DOMAIN=localhost
CSRF_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SAMESITE=Lax

# --- IA ---
# Texte et carrousel : Google AI Studio
GEMINI_API_KEY=colle_ta_cle_gemini_ici
GEMINI_MODEL=gemini-flash-lite-latest
# Images : Cloudflare Workers AI
CF_ACCOUNT_ID=colle_ton_account_id_ici
CF_API_TOKEN=colle_ton_token_cloudflare_ici

# Limites globales par jour, à régler selon les quotas du fournisseur
AI_DAILY_LIMIT_TEXT=150
AI_DAILY_LIMIT_IMAGE=150

# --- Légal ---
# Doit correspondre à la date « Dernière mise à jour » des conditions d'utilisation
TERMS_VERSION=2026-10-22
